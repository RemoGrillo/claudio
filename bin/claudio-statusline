#!/usr/bin/env python3
# Claude Code status line: shows the model and usage, and saves the usage limits (rate_limits, already part of
# the data Claude Code passes to the status line) to ~/.cache/claudio/usage.json for the tray icon (claudio-tray).
# No network calls.
import json
import os
import sys
import time

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claudio", "usage.json")

try:
    data = json.load(sys.stdin)
except Exception:
    data = {}

limits = data.get("rate_limits") or {}
if limits.get("five_hour") or limits.get("seven_day"):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"updated": int(time.time()), "rate_limits": limits}, f)
        os.replace(tmp, CACHE)
    except Exception:
        pass

parts = []
model = (data.get("model") or {}).get("display_name")
if model:
    parts.append(model)
for key, name in (("five_hour", "5h"), ("seven_day", "7d")):
    v = (limits.get(key) or {}).get("used_percentage")
    if v is not None:
        parts.append(f"{name} {round(v)}%")
ctx = (data.get("context_window") or {}).get("used_percentage")
if ctx is not None:
    parts.append(f"context {round(ctx)}%")
print(" · ".join(parts))

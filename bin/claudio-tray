#!/usr/bin/env python3
# Tray icon (StatusNotifierItem: KDE Plasma and any SNI tray) showing how much of Claude's 5-hour usage window
# is used. It only reads ~/.cache/claudio/usage.json, written by the Claude Code status line (claudio-statusline):
# no network calls.
# It is also Claudio's button (KDE): left click = show/hide (claudio-toggle), middle click = notification with the
# details, right click = menu (Tray.menu_layout: reveal animation, glow and colour themes). The number
# glows while a Claudio chat is working (state from ~/.cache/claudio/sessions.json, written by the Claude Code
# hooks through claudio-hook).
import configparser
import json
import math
import os
import signal
import subprocess
import time

import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gio, GLib, GdkPixbuf

HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = os.path.realpath(os.path.join(HERE, "..", "share", "claudio"))
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claudio")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "claudio")
USAGE = os.path.join(CACHE_DIR, "usage.json")
SESSIONS = os.path.join(CACHE_DIR, "sessions.json")
TOGGLE = os.path.join(HERE, "claudio-toggle")
# glow with the same colours as the halo around Claudio, from the shared colors.conf (also read by the KWin script
# claudio-glow): 2-4 hues cycling, with an optional brief flash of the "highlight" colour on every cycle.
# 24 frames of 150 ms = one cycle of 3.6 s
COLORS = os.path.join(CONFIG_DIR, "colors.conf")
DEFAULT_COLORS = os.path.join(SHARE, "colors.conf")
DEFAULTS = {"color1": "#2fb4ff", "color2": "#ff8a2b", "highlight": "#ffffff"}
FRAMES = 24
STEP_MS = 150


def rgb(hexa, fallback):
    try:
        h = hexa.strip().lstrip("#")
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)) if len(h) == 6 else rgb(fallback, fallback)
    except ValueError:
        return rgb(fallback, fallback)


def read_colors():
    """(hues, highlight): 2 to 4 hues (color3 and color4 are optional) and the flash colour (None = no flash)."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(COLORS if os.path.exists(COLORS) else DEFAULT_COLORS)
    except configparser.Error:
        pass
    sec = conf["glow"] if conf.has_section("glow") else {}
    hues = [rgb(sec.get(k, v), v) for k, v in (("color1", DEFAULTS["color1"]), ("color2", DEFAULTS["color2"]))]
    for k in ("color3", "color4"):
        if not sec.get(k, "").strip():
            break
        hues.append(rgb(sec[k], DEFAULTS["color1"]))
    flash = sec.get("highlight", DEFAULTS["highlight"]).strip()
    return tuple(hues), (rgb(flash, DEFAULTS["highlight"]) if flash else None)


# Claudio's tabs follow colors.conf too: the active-tab gradient goes to tabs.css (loaded by claudio after the main
# stylesheet) and the Claudio Ghostty reloads its config (SIGUSR2)
TABS_CSS = os.path.join(CACHE_DIR, "tabs.css")


def claudio_ghostty():
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")
        except OSError:
            continue
        if argv[0].endswith("ghostty") and any(a.startswith("--config-file=") and a.endswith("claudio.conf") for a in argv):
            yield int(pid)


def color_tabs(colors):
    hues, _ = colors
    rgba = lambda c: "rgba({}, {}, {}, 0.45)".format(*(round(x * 255) for x in c))
    css = ("/* generated by claudio-tray from colors.conf: do not edit */\n"
           f"window tabbar tab:selected {{\n  background: linear-gradient(100deg, {', '.join(rgba(c) for c in hues)});\n}}\n")
    try:
        with open(TABS_CSS) as f:
            if f.read() == css:
                return
    except OSError:
        pass
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(TABS_CSS + ".tmp", "w") as f:
        f.write(css)
    os.replace(TABS_CSS + ".tmp", TABS_CSS)
    for pid in claudio_ghostty():
        os.kill(pid, signal.SIGUSR2)


def pulse(colors):
    hues, flash = colors
    n = len(hues)
    out = []
    for i in range(FRAMES):
        t = i / FRAMES
        m = t * n                                               # color1 → color2 → … → color1
        k = int(m)
        f = 0.5 - 0.5 * math.cos(math.pi * (m - k))            # smooth blend between two hues
        col = [a + (b - a) * f for a, b in zip(hues[k], hues[(k + 1) % n])]
        if flash:
            sheen = math.exp(-((t - 0.75) / 0.06) ** 2) * 0.75  # flash on the way back
            col = [c + (r - c) * sheen for c, r in zip(col, flash)]
        strength = 0.85 + 0.15 * math.cos(4 * math.pi * t)
        out.append((strength, "#" + "".join(f"{round(c * 255):02x}" for c in col)))
    return out


# ---- right-click menu (com.canonical.dbusmenu) ----
# The menu is described by Tray.menu_layout() and rebuilt from the current settings whenever it opens or changes.
# Plasma's dbusmenu client puts every radio item in a group of its own, so it does not make them mutually exclusive by
# itself: the menu has to send every changed toggle-state (ItemsPropertiesUpdated) and AboutToShow always asks Plasma to
# refetch the submenu, otherwise the previously selected choice stays ticked next to the new one.
EFFECT = os.path.join(HERE, "claudio-effect")
COLOR_EDITOR = os.path.join(HERE, "claudio-colors")
KWINRC = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kwinrc")
THEMES = os.path.join(SHARE, "themes.json")

EFFECTS = [("glitch", "Glitch"), ("decrypt", "Decrypt"), ("scan", "Scan"), ("slide", "Slide"), ("none", "None")]
SHADER_EFFECTS = {"glitch", "decrypt", "scan"}
SPEEDS = [("0.5", "0.5× (slow)"), ("0.75", "0.75×"), ("1.0", "1× (normal)"), ("1.5", "1.5×"), ("2.0", "2×"),
          ("3.0", "3× (very fast)")]
INTENSITIES = [("0.5", "Subtle"), ("1.0", "Normal"), ("1.5", "Strong"), ("2.0", "Over the top")]
BANDS = [("8", "Few (8)"), ("14", "Normal (14)"), ("24", "Many (24)"), ("40", "Dense (40)")]


def read_kwin(group, key, default):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(KWINRC)
        return cp.get(group, key, fallback=default)
    except (OSError, configparser.Error):
        return default


def reveal(key, default):
    return read_kwin("Effect-claudio_reveal", key, default)


def set_reveal(*args):
    subprocess.run([EFFECT, *args], stdout=subprocess.DEVNULL)


def glow_enabled():
    return read_kwin("Plugins", "claudio-glowEnabled", "false").strip().lower() == "true"


def set_glow(on):
    quiet = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["kwriteconfig6", "--file", "kwinrc", "--group", "Plugins", "--key", "claudio-glowEnabled",
                    "true" if on else "false"], **quiet)
    if not on:
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", "claudio-glow"], **quiet)
    subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"], **quiet)


# ---- colour themes: colors.conf [glow] holds the colours in use (read by the glow and the tray icon), [custom] the
# user's own theme. claudio-colors (the colour editor) writes the same format.
KEYS = ("color1", "color2", "color3", "color4", "highlight")
HEADER = """; Claudio's colours: the animated glow around the sidebar (KWin script claudio-glow), the tray icon while Claude is
; working (claudio-tray) and the active tab. Pick a theme or make your own with the colour editor (claudio-colors, also in
; the tray menu → Glow → Customise colours…). Changes show up by themselves within a few seconds.
; [glow] holds the colours in use; [custom] keeps your own theme while a built-in one is selected.
"""


def themes():
    try:
        with open(THEMES) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def theme_colors(t):
    c = list(t.get("colors", []))[:4]
    return dict(zip(KEYS, c + [""] * (4 - len(c)) + [t.get("highlight", "")]))


def read_conf():
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(COLORS if os.path.exists(COLORS) else DEFAULT_COLORS)
    except configparser.Error:
        pass
    return conf


def section(conf, name):
    return {k: conf.get(name, k, fallback="").strip() for k in KEYS} if conf.has_section(name) else None


def current_theme(conf):
    t = conf.get("glow", "theme", fallback="").strip().lower()
    if t:
        return t
    # colors.conf from before themes: a built-in theme if the colours match one, otherwise custom
    glow = section(conf, "glow")
    return next((k for k, t in themes().items() if theme_colors(t) == glow), "custom")


def write_colors(theme, glow, custom):
    lines = [HEADER, "[glow]", "; aurora, nebula, ember or custom", f"theme={theme}"]
    lines += [f"{k}={glow.get(k, '')}" for k in KEYS]
    lines += ["", "[custom]"] + [f"{k}={custom.get(k, '')}" for k in KEYS]
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(COLORS + ".tmp", "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(COLORS + ".tmp", COLORS)


def set_theme(name):
    conf = read_conf()
    glow = section(conf, "glow") or theme_colors(themes().get("aurora", {}))
    custom = section(conf, "custom") or glow
    if name == "custom":
        write_colors("custom", custom, custom)
    elif name in themes():
        write_colors(name, theme_colors(themes()[name]), custom)


def same(a, b):
    try:
        return abs(float(a) - float(b)) < 1e-6
    except ValueError:
        return str(a).strip().lower() == str(b).strip().lower()


def label_of(choices, value):
    return next((l for v, l in choices if same(v, value)), value)


def radios(choices, current, write):
    return [dict(label=l, toggle=("radio", same(v, current)), action=lambda v=v: write(v)) for v, l in choices]


MENU_PATH = "/MenuBar"
MENU_XML = """
<node>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="as" direction="in"/>
      <arg type="u" direction="out"/><arg type="(ia{sv}av)" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg type="ai" direction="in"/><arg type="as" direction="in"/><arg type="a(ia{sv})" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/>
    </method>
    <method name="Event">
      <arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="in"/><arg type="u" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg type="a(isvu)" direction="in"/><arg type="ai" direction="out"/>
    </method>
    <method name="AboutToShow"><arg type="i" direction="in"/><arg type="b" direction="out"/></method>
    <method name="AboutToShowGroup">
      <arg type="ai" direction="in"/><arg type="ai" direction="out"/><arg type="ai" direction="out"/>
    </method>
    <signal name="ItemsPropertiesUpdated"><arg type="a(ia{sv})"/><arg type="a(ias)"/></signal>
    <signal name="LayoutUpdated"><arg type="u"/><arg type="i"/></signal>
  </interface>
</node>
"""


class Menu:
    """Right-click menu. layout() returns a list of entries: None = separator, or a dict with label and optionally icon,
    action, toggle=("radio"|"checkmark", checked), enabled=False and children=[…] for a submenu."""

    def __init__(self, bus, layout):
        self.bus = bus
        self.layout = layout
        self.revision = 1
        self.items, self.actions = {}, {}
        self.build()
        info = Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0]
        bus.register_object(MENU_PATH, info, self.method, self.property, None)

    def build(self):
        """Rebuilds the items (ids stay the same as long as the structure does) and returns the previous ones."""
        old = self.items
        self.items, self.actions, self.next_id = {}, {}, 1
        self.items[0] = ({"children-display": "submenu"}, [self.add(e) for e in self.layout()])
        return old

    def add(self, e):
        i = self.next_id
        self.next_id += 1
        if e is None:
            self.items[i] = ({"type": "separator"}, [])
            return i
        props = {"label": e["label"]}
        if e.get("icon"):
            props["icon-name"] = e["icon"]
        if "toggle" in e:
            props["toggle-type"] = e["toggle"][0]
            props["toggle-state"] = 1 if e["toggle"][1] else 0
        if e.get("enabled") is False:
            props["enabled"] = False
        if "children" in e:
            props["children-display"] = "submenu"
        if e.get("action"):
            self.actions[i] = e["action"]
        self.items[i] = (props, [])
        self.items[i][1].extend(self.add(c) for c in e.get("children", []))
        return i

    @staticmethod
    def props_variant(props):
        return {k: GLib.Variant("b" if isinstance(v, bool) else "i" if isinstance(v, int) else "s", v)
                for k, v in props.items()}

    def variant(self, i, depth):
        props, children = self.items[i]
        sub = [GLib.Variant("(ia{sv}av)", self.variant(c, depth - 1)) for c in children] if depth != 0 else []
        return (i, self.props_variant(props), sub)

    def refresh(self):
        """Rebuilds and tells the panel what changed. Returns True if anything did."""
        old = self.build()
        if {i: c for i, (_, c) in old.items()} != {i: c for i, (_, c) in self.items.items()}:
            self.revision += 1
            self.bus.emit_signal(None, MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated",
                                 GLib.Variant("(ui)", (self.revision, 0)))
            return True
        changed = [(i, self.props_variant(p)) for i, (p, _) in self.items.items() if old[i][0] != p]
        if changed:
            # every item whose label, tick or state changed, including the radio that is no longer selected
            self.bus.emit_signal(None, MENU_PATH, "com.canonical.dbusmenu", "ItemsPropertiesUpdated",
                                 GLib.Variant("(a(ia{sv})a(ias))", (changed, [])))
        return bool(changed)

    def property(self, conn, sender, path, iface, name):
        return {"Version": GLib.Variant("u", 3), "TextDirection": GLib.Variant("s", "ltr"),
                "Status": GLib.Variant("s", "normal"), "IconThemePath": GLib.Variant("as", [])}.get(name)

    def clicked(self, i):
        if i in self.actions:
            self.actions[i]()
            GLib.idle_add(self.refresh)

    def method(self, conn, sender, path, iface, name, param, inv):
        a = param.unpack()
        if name == "GetLayout":
            root = a[0] if a[0] in self.items else 0
            inv.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self.variant(root, a[1]))))
        elif name == "GetGroupProperties":
            ids = a[0] or list(self.items)
            inv.return_value(GLib.Variant("(a(ia{sv}))", ([self.variant(i, 0)[:2] for i in ids if i in self.items],)))
        elif name == "GetProperty":
            v = self.variant(a[0], 0)[1].get(a[1]) if a[0] in self.items else None
            inv.return_value(GLib.Variant("(v)", (v if v is not None else GLib.Variant("s", ""),)))
        elif name == "Event":
            inv.return_value(None)
            if a[1] == "clicked":
                self.clicked(a[0])
        elif name == "EventGroup":
            inv.return_value(GLib.Variant("(ai)", ([],)))
            for i, event, _d, _t in a[0]:
                if event == "clicked":
                    self.clicked(i)
        elif name == "AboutToShow":
            self.refresh()
            inv.return_value(GLib.Variant("(b)", (True,)))     # always refetch: see the comment at the top
        elif name == "AboutToShowGroup":
            self.refresh()
            inv.return_value(GLib.Variant("(aiai)", ([i for i in a[0] if i in self.items], [])))
        else:
            inv.return_value(None)


SNI_PATH = "/StatusNotifierItem"
WATCHER = "org.kde.StatusNotifierWatcher"

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewTitle"/>
  </interface>
</node>
"""

SVG = """<svg xmlns="http://www.w3.org/2000/svg" width="{s}" height="{s}" viewBox="0 0 64 64">
  <defs>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="{blur}" result="b"/>
      <feFlood flood-color="{hue}" flood-opacity="{strength}"/>
      <feComposite in2="b" operator="in" result="c"/>
      <feMerge><feMergeNode in="c"/><feMergeNode in="c"/><feMergeNode in="c"/><feMergeNode in="c"/></feMerge>
    </filter>
    <filter id="ringglow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="2.6" result="b"/>
      <feFlood flood-color="{hue}" flood-opacity="{strength}"/>
      <feComposite in2="b" operator="in" result="c"/>
      <feMerge><feMergeNode in="c"/><feMergeNode in="c"/></feMerge>
    </filter>
    <clipPath id="round"><circle cx="32" cy="32" r="32"/></clipPath>
  </defs>
  {ring_glow}
  <circle cx="32" cy="32" r="28" fill="none" stroke="{track}" stroke-width="6"/>
  <circle cx="32" cy="32" r="28" fill="none" stroke="{color}" stroke-width="6" stroke-linecap="round"
          stroke-dasharray="{arc} 999" transform="rotate(-90 32 32)"/>
  {text_glow}
  <text x="32" y="{y}" font-family="Inter, sans-serif" font-weight="700" font-size="{fs}"
        text-anchor="middle" fill="#ffffff">{text}</text>
  {below}
</svg>"""


def usage_color(p):
    if p is None:
        return "#8a8a8a"
    if p >= 90:
        return "#ef5350"
    if p >= 70:
        return "#ffb74d"
    return "#66bb6a"


def read_usage():
    """Returns (data, 5-hour percentage or None)."""
    try:
        with open(USAGE) as f:
            data = json.load(f)
    except Exception:
        return None, None
    now = time.time()
    limits = data.get("rate_limits") or {}
    for key in ("five_hour", "seven_day"):
        l = limits.get(key)
        # the window was reset after the last data point: usage starts again from 0
        if l and l.get("resets_at") and l["resets_at"] < now:
            l["used_percentage"] = 0
            l["reset"] = True
    p = (limits.get("five_hour") or {}).get("used_percentage")
    return data, (None if p is None else max(0, min(100, round(p))))


def interrupted(c):
    """Esc triggers no hook: the interruption only shows up at the end of the transcript."""
    tr = c.get("transcript")
    try:
        if tr and os.path.getmtime(tr) > c.get("ts", 0):
            with open(tr, "rb") as f:
                f.seek(max(0, os.path.getsize(tr) - 16384))
                lines = [r for r in f.read().splitlines() if r.strip()]
            return bool(lines) and b"[Request interrupted by user" in lines[-1]
    except OSError:
        pass
    return False


_titles = {}


def chat_title(tr):
    """Title Claude Code gave the chat (latest "ai-title" line), cached until the file changes."""
    try:
        mt = os.path.getmtime(tr)
    except (OSError, TypeError):
        return ""
    if tr in _titles and _titles[tr][0] == mt:
        return _titles[tr][1]
    t = ""
    try:
        with open(tr, "rb") as f:
            for line in f:
                if b'"ai-title"' in line:
                    try:
                        t = json.loads(line).get("aiTitle") or t
                    except ValueError:
                        pass
    except OSError:
        pass
    _titles[tr] = (mt, t)
    return t


def claudio_chats():
    """Chats open in Claudio's tabs: list of (title, working?) for the processes still alive."""
    try:
        with open(SESSIONS) as f:
            chats = json.load(f).get("chats") or {}
    except Exception:
        return []
    out = []
    for pid, c in sorted(chats.items(), key=lambda kv: kv[1].get("ts", 0)):
        if not os.path.exists(f"/proc/{pid}"):
            continue
        busy = c.get("state") == "busy" and not interrupted(c)
        out.append((chat_title(c.get("transcript")) or "New chat", busy))
    return out


def claudio_busy():
    """True if at least one Claudio chat is working."""
    return any(b for _, b in claudio_chats())


def minutes_to_reset(data):
    """Minutes left before the 5-hour window resets (None if unknown or already past)."""
    l = ((data or {}).get("rate_limits") or {}).get("five_hour") or {}
    if not l.get("resets_at") or l.get("reset"):
        return None
    return max(0, int((l["resets_at"] - time.time()) // 60))


def render_svg(p, size, strength=0.0, hue="#ff9e5e", minutes=None):
    text = "–" if p is None else str(p)
    below = ""
    if minutes is None:
        fs = 26 if len(text) >= 3 else 32
        y = 32 + fs * 0.36
    else:
        # smaller percentage at the top, minutes to reset below it (inside the ring)
        fs = 17 if len(text) >= 3 else 20
        y = 30
        below = (f'<text x="32" y="50" font-family="Inter, sans-serif" font-weight="700" font-size="{16 if minutes >= 100 else 19}" '
                 f'text-anchor="middle" fill="#d8d8d8">{minutes}</text>')
    text_glow = ""
    if strength:
        text_glow = (f'<text x="32" y="{y}" font-family="Inter, sans-serif" font-weight="700" font-size="{fs}" '
                     f'text-anchor="middle" fill="#ffffff" filter="url(#glow)">{text}</text>')
    # the ring glows too, with a tinted track (the filled arc keeps the usage colour)
    track = "rgba(255,255,255,0.22)"
    ring_glow = ""
    if strength:
        track = hue
        # clipped to a circle: outside the icon it would be cut square
        ring_glow = ('<g clip-path="url(#round)"><circle cx="32" cy="32" r="28" fill="none" stroke="#ffffff" '
                     'stroke-width="4" filter="url(#ringglow)"/></g>')
    return SVG.format(s=size, track=track, ring_glow=ring_glow, color=usage_color(p),
                      arc=0 if p is None else 175.9 * p / 100,
                      y=y, fs=fs, text=text, text_glow=text_glow, below=below, blur=3.4,
                      strength=round(strength, 2), hue=hue)


def pixmap(p, size, strength=0.0, hue="#ff9e5e", minutes=None):
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.write(render_svg(p, size, strength, hue, minutes).encode())
    loader.close()
    pb = loader.get_pixbuf()
    w, h, rs = pb.get_width(), pb.get_height(), pb.get_rowstride()
    src = pb.get_pixels()
    out = bytearray(w * h * 4)
    for yy in range(h):
        for xx in range(w):
            i = yy * rs + xx * 4
            o = (yy * w + xx) * 4
            out[o] = src[i + 3]          # ARGB in network byte order
            out[o + 1:o + 4] = src[i:i + 3]
    return (w, h, bytes(out))


def when(ts):
    if not ts:
        return "?"
    t = time.localtime(ts)
    today = time.localtime()
    if t.tm_yday == today.tm_yday and t.tm_year == today.tm_year:
        return time.strftime("%H:%M", t)
    return time.strftime("%a %d/%m %H:%M", t)


def description(data):
    if not data:
        return "No data yet: open Claude Code and send a message."
    lines = []
    limits = data.get("rate_limits") or {}
    for key, name in (("five_hour", "Session (5 h)"), ("seven_day", "Week")):
        l = limits.get(key)
        if l:
            lines.append(f"{name}: {round(l.get('used_percentage') or 0)}% — resets {when(l.get('resets_at'))}")
    chats = claudio_chats()
    if chats:
        lines.append("")
        lines.append("Claudio chats:")
        lines += [f"{'◐' if b else '·'} {t}" + (" — working" if b else "") for t, b in chats]
        lines.append("")
    minutes = int((time.time() - data.get("updated", 0)) / 60)
    lines.append("Updated " + ("just now" if minutes < 1 else f"{minutes} min ago" if minutes < 120
                               else f"at {when(data.get('updated'))}"))
    return "\n".join(lines)


class Tray:
    def __init__(self):
        self.data, self.perc = read_usage()
        self.icons = []
        self.signature = None
        self.busy = False
        self.frames = []
        self.frame = 0
        self.timer = 0
        self.colors = read_colors()
        color_tabs(self.colors)
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.menu = Menu(self.bus, self.menu_layout)
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        info = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        self.bus.register_object(SNI_PATH, info, self.method, self.property, None)
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
        Gio.bus_watch_name_on_connection(self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE,
                                         lambda *a: self.register(), None)
        self.update()
        self.monitor = Gio.File.new_for_path(CACHE_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", lambda *a: self.update())
        GLib.timeout_add_seconds(30, self.update)
        GLib.timeout_add_seconds(2, self.check_busy)
        os.makedirs(CONFIG_DIR, exist_ok=True)
        self.color_monitor = Gio.File.new_for_path(CONFIG_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.color_monitor.connect("changed", lambda *a: self.update())

    def menu_layout(self):
        effect = reveal("Effect", "glitch").strip().lower()
        speed, intensity, bands = reveal("Speed", "1.0"), reveal("Intensity", "1.0"), reveal("Bands", "14")
        glow_on = glow_enabled()
        theme = current_theme(read_conf())
        theme_choices = [(k, t.get("name", k)) for k, t in themes().items()] + [("custom", "Custom")]
        return [
            dict(label="Show/hide Claudio", icon="view-right-new", action=lambda: subprocess.Popen([TOGGLE])),
            dict(label="Usage details", icon="dialog-information", action=self.notify),
            None,
            dict(label=f"Reveal animation: {label_of(EFFECTS, effect)}", icon="preferences-desktop-effects", children=[
                *radios(EFFECTS, effect, set_reveal),
                None,
                dict(label=f"Speed: {label_of(SPEEDS, speed)}", icon="speedometer", enabled=effect != "none",
                     children=radios(SPEEDS, speed, lambda v: set_reveal("speed", v))),
                dict(label=f"Intensity: {label_of(INTENSITIES, intensity)}", icon="draw-brush",
                     enabled=effect in SHADER_EFFECTS,
                     children=radios(INTENSITIES, intensity, lambda v: set_reveal("intensity", v))),
                dict(label=f"Glitch bands: {label_of(BANDS, bands)}", icon="view-list-details", enabled=effect == "glitch",
                     children=radios(BANDS, bands, lambda v: set_reveal("bands", v))),
            ]),
            dict(label="Glow: " + (label_of(theme_choices, theme) if glow_on else "off"), icon="color-management", children=[
                dict(label="Glow around Claudio", toggle=("checkmark", glow_on), action=lambda: set_glow(not glow_on)),
                None,
                *radios(theme_choices, theme, set_theme),
                None,
                dict(label="Customise colours…", icon="preferences-desktop-color",
                     action=lambda: subprocess.Popen([COLOR_EDITOR])),
            ]),
        ]

    def register(self):
        self.bus.call(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
                      GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

    def update(self):
        self.data, self.perc = read_usage()
        busy = claudio_busy()
        minutes = minutes_to_reset(self.data)
        colors = read_colors()
        if colors != self.colors:
            color_tabs(colors)
        self.colors = colors
        if (self.perc, busy, minutes, self.colors) != self.signature or not self.icons:
            self.signature = (self.perc, busy, minutes, self.colors)
            self.busy = busy
            self.icons = [pixmap(self.perc, d, minutes=minutes) for d in (32, 48, 64)]
            self.frames = [[pixmap(self.perc, d, k, c, minutes) for d in (32, 48, 64)]
                           for k, c in pulse(self.colors)] if busy else []
            if busy and not self.timer:
                self.timer = GLib.timeout_add(STEP_MS, self.animate)
            self.signal("NewIcon")
        self.signal("NewToolTip")
        return True

    def check_busy(self):
        # a process exiting or an Esc interruption produce no file events: check periodically
        if self.busy and not claudio_busy():
            self.update()
        return True

    def animate(self):
        if not self.busy:
            self.timer = 0
            self.signal("NewIcon")
            return False
        self.frame = (self.frame + 1) % len(self.frames)
        self.signal("NewIcon")
        return True

    def current_icon(self):
        if self.busy and self.frames:
            return self.frames[self.frame % len(self.frames)]
        return self.icons

    def signal(self, name):
        self.bus.emit_signal(None, SNI_PATH, "org.kde.StatusNotifierItem", name, None)

    def title(self):
        t = "Claude" if self.perc is None else f"Claude: {self.perc}% (5 h)"
        return t + (" — working" if self.busy else "")

    def property(self, conn, sender, path, iface, name):
        if name == "IconPixmap":
            return GLib.Variant("a(iiay)", self.current_icon())
        if name == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)", ("", [], self.title(), description(self.data)))
        values = {"Category": "ApplicationStatus", "Id": "claudio", "Title": self.title(),
                  "Status": "Active", "IconName": ""}
        if name == "ItemIsMenu":
            return GLib.Variant("b", False)
        if name == "Menu":
            return GLib.Variant("o", MENU_PATH)
        return GLib.Variant("s", values.get(name, ""))

    def method(self, conn, sender, path, iface, name, param, inv):
        if name == "Activate" and "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            subprocess.Popen([TOGGLE])
        elif name in ("Activate", "SecondaryActivate", "ContextMenu"):
            self.notify()
        inv.return_value(None)

    def notify(self):
        self.data, self.perc = read_usage()
        subprocess.Popen(["notify-send", "-a", "Claudio", "-i", "dialog-information",
                          "-h", "string:x-canonical-private-synchronous:claudio-usage",
                          self.title(), description(self.data)])


if __name__ == "__main__":
    os.makedirs(CACHE_DIR, exist_ok=True)
    Tray()
    GLib.MainLoop().run()

#!/usr/bin/env python3
# Claude Code hook: keeps track of which Claudio chats (one per tab of the Claudio Ghostty) are working.
# Usage: claudio-hook busy|idle  (hook JSON on stdin). Other Claude Code instances (normal terminals, IDEs) are ignored.
# Writes ~/.cache/claudio/sessions.json = {"chats": {pid: {...}}}, read by claudio-tray for the glow and the
# tooltip. When a chat finishes a job that took at least LONG seconds, it sends a notification with the chat title.
import fcntl
import json
import os
import subprocess
import sys
import time

FILE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claudio", "sessions.json")
LONG = 30


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def parent(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def claudio_claude_pid():
    """Walks up the process tree: if it reaches the Claudio Ghostty, returns the pid of claude."""
    pid, child = os.getppid(), 0
    while pid > 1:
        c = cmdline(pid)
        if "ghostty" in c and "claudio.conf" in c:
            return child
        pid, child = parent(pid), pid
    return 0


def title(transcript):
    """Latest title generated by Claude Code (the "ai-title" line of the transcript)."""
    t = ""
    try:
        with open(transcript, "rb") as f:
            for line in f:
                if b'"ai-title"' in line:
                    try:
                        t = json.loads(line).get("aiTitle") or t
                    except ValueError:
                        pass
    except OSError:
        pass
    return t


try:
    data = json.load(sys.stdin)
except Exception:
    data = {}
pid = claudio_claude_pid()
if not pid or len(sys.argv) < 2:
    sys.exit(0)
state, now = sys.argv[1], time.time()
os.makedirs(os.path.dirname(FILE), exist_ok=True)
with open(FILE + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(FILE) as f:
            everything = json.load(f)
    except Exception:
        everything = {}
    chats = {k: v for k, v in (everything.get("chats") or {}).items() if os.path.exists(f"/proc/{k}")}
    old = chats.get(str(pid), {})
    new = {"state": state, "ts": now, "event": data.get("hook_event_name", ""),
           "session": data.get("session_id", ""), "transcript": data.get("transcript_path", ""),
           "start": old.get("start", now) if old.get("state") == "busy" else now}
    if data.get("hook_event_name") == "SessionEnd":
        chats.pop(str(pid), None)
    else:
        chats[str(pid)] = new
    tmp = FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"chats": chats}, f)
    os.replace(tmp, FILE)

if (data.get("hook_event_name") == "Stop" and old.get("state") == "busy"
        and now - old.get("start", now) >= LONG):
    name = title(new["transcript"]) or "Claudio chat"
    minutes, seconds = divmod(int(now - old["start"]), 60)
    subprocess.Popen(["notify-send", "-a", "Claudio", "-i", "io.github.remogrillo.claudio",
                      f"✓ {name}", f"Claude is done ({minutes} min {seconds} s)" if minutes
                      else f"Claude is done ({seconds} s)"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

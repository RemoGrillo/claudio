#!/usr/bin/env python3
# Copilot key → Claudio (claudio-toggle), KDE only.
# The key sends Meta+Shift+F23; with Meta+Shift held xkb turns it into XF86Assistant, which Qt does not know,
# so KDE's shortcuts never see it. This reads the keyboards directly (the user must be in the "input" group)
# and runs claudio-toggle on every F23 press. It only reads: keys still reach applications as usual.
import glob
import os
import select
import struct
import subprocess
import time

FMT = "llHHi"
SZ = struct.calcsize(FMT)
EV_KEY, KEY_F23 = 1, 193
TOGGLE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "claudio-toggle")


def keyboards():
    return sorted(set(os.path.realpath(p) for p in glob.glob("/dev/input/by-path/*-event-kbd")))


def listen():
    fds = []
    for p in keyboards():
        try:
            fds.append(os.open(p, os.O_RDONLY))
        except OSError:
            pass
    if not fds:
        time.sleep(5)
        return
    try:
        while True:
            ready, _, _ = select.select(fds, [], [])
            for fd in ready:
                data = os.read(fd, SZ * 64)   # raises OSError if the device goes away (e.g. suspend)
                for i in range(0, len(data) - SZ + 1, SZ):
                    _, _, kind, code, value = struct.unpack_from(FMT, data, i)
                    if kind == EV_KEY and code == KEY_F23 and value == 1:
                        subprocess.Popen([TOGGLE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        time.sleep(1)
    finally:
        for fd in fds:
            os.close(fd)


while True:
    listen()

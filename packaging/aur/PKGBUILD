# Maintainer: Remo Grillo <10984018+RemoGrillo@users.noreply.github.com>
pkgname=claudio
pkgver=0.1.0
pkgrel=1
pkgdesc="Claude Code in a sidebar for KDE Plasma: Ghostty quick terminal with reveal effects, animated glow and a usage tray icon"
arch=('x86_64' 'aarch64')
url="https://github.com/RemoGrillo/claudio"
license=('GPL-3.0-or-later')
depends=('ghostty' 'kwin' 'plasma-workspace' 'kde-cli-tools' 'kconfig' 'qt6-tools' 'qt6-declarative'
         'python' 'python-gobject' 'librsvg' 'libnotify' 'glib2' 'wayland' 'xdg-utils')
makedepends=('qt6-shadertools')
optdepends=('claude-code: the Claude Code CLI (or install it with the official native installer)'
            'kwin-effects-better-blur-dx: stronger frosted-glass blur behind the sidebar')
install=claudio.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr
}

package() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
